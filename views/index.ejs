    <script>
      // Enhanced Theme Toggle System
      const html = document.documentElement;
      const themeToggle = document.getElementById('themeToggle');
      const themeIcon = document.getElementById('themeIcon');
      
      const setIcon = () => {
        if (themeIcon) {
          themeIcon.textContent = html.classList.contains('dark') ? '☀️' : '🌙';
        }
      };
      
      const applyStoredTheme = () => {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          html.classList.add('dark');
        } else {
          html.classList.remove('dark');
        }
        setIcon();
      };
      
      const toggleTheme = () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        setIcon();
      };
      
      themeToggle?.addEventListener('click', toggleTheme);
      applyStoredTheme();

      // Mobile Menu Toggle
      const btn = document.getElementById('menuBtn');
      const menu = document.getElementById('mobileMenu');
      btn?.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden');
      });
      
      // Set current year
      document.getElementById('year').textContent = new Date().getFullYear();

      // Enhanced Animated Counters
      const counters = document.querySelectorAll('.stats-counter');
      const animateCounter = (entry) => {
        const el = entry.target;
        const target = parseFloat(el.dataset.target);
        const suffix = el.dataset.suffix || '';
        let current = 0;
        const steps = 60;
        const inc = target / steps;
        
        const tick = () => {
          current += inc;
          if (current >= target) {
            el.textContent = (Math.round(target * 10) / 10) + suffix;
          } else {
            el.textContent = (Math.round(current * 10) / 10) + suffix;
            requestAnimationFrame(tick);
          }
        };
        requestAnimationFrame(tick);
      };
      
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            animateCounter(e);
            counterObserver.unobserve(e.target);
          }
        });
      }, { threshold: 0.6 });
      
      counters.forEach(c => counterObserver.observe(c));

      // Enhanced Interactive Demo
      const demo = document.getElementById('demoCanvas');
      const toggles = document.querySelectorAll('.demo-toggle');
      const state = { rain: false, seismic: false, saturation: false };
      
      const renderDemo = () => {
        const layers = demo.querySelectorAll('.demo-layer');
        layers.forEach(layer => {
          const layerType = layer.dataset.layer;
          if (state[layerType]) {
            layer.classList.add('active');
            layer.style.opacity = '1';
          } else {
            layer.classList.remove('active');
            layer.style.opacity = '0';
          }
        });
      };
      
      toggles.forEach(btn => {
        btn.addEventListener('click', () => {
          const toggleType = btn.dataset.toggle;
          state[toggleType] = !state[toggleType];
          
          // Update button state
          if (state[toggleType]) {
            btn.classList.add('bg-brand-500/20', 'border-brand-500', 'text-brand-400');
            btn.classList.remove('border-slate-700', 'text-slate-200');
          } else {
            btn.classList.remove('bg-brand-500/20', 'border-brand-500', 'text-brand-400');
            btn.classList.add('border-slate-700', 'text-slate-200');
          }
          
          renderDemo();
        });
      });
      
      renderDemo();

      // FAQ Search Functionality
      const faqSearch = document.getElementById('faqSearch');
      const accordions = document.querySelectorAll('.accordion');
      
      faqSearch?.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase();
        
        accordions.forEach(accordion => {
          const question = accordion.querySelector('button span').textContent.toLowerCase();
          const answer = accordion.querySelector('.accordion-body').textContent.toLowerCase();
          
          if (question.includes(searchTerm) || answer.includes(searchTerm)) {
            accordion.style.display = 'block';
            // Highlight search terms
            if (searchTerm) {
              const highlightedQuestion = accordion.querySelector('button span').textContent.replace(
                new RegExp(searchTerm, 'gi'),
                `<span class="search-highlight">${searchTerm}</span>`
              );
              accordion.querySelector('button span').innerHTML = highlightedQuestion;
            }
          } else {
            accordion.style.display = 'none';
          }
        });
      });

      // Enhanced Accordion Animation
      accordions.forEach(accordion => {
        const button = accordion.querySelector('button');
        const icon = accordion.querySelector('.accordion-icon');
        
        button.addEventListener('click', () => {
          const isOpen = accordion.classList.contains('open');
          
          if (isOpen) {
            accordion.classList.remove('open');
            icon.style.transform = 'rotate(0deg)';
          } else {
            accordion.classList.add('open');
            icon.style.transform = 'rotate(180deg)';
          }
        });
      });

      // Smooth Scrolling for Navigation Links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });

      // Newsletter Signup (Placeholder)
      const newsletterForm = document.querySelector('footer form');
      newsletterForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        // Add newsletter signup logic here
        console.log('Newsletter signup submitted');
      });

      // Intersection Observer for Animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const animationObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fade-in');
          }
        });
      }, observerOptions);

      // Observe elements for animation
      document.querySelectorAll('.feature-card, .testimonial-card, .pricing-card').forEach(el => {
        animationObserver.observe(el);
      });

      // Performance optimization: Lazy load images
      if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              img.src = img.dataset.src;
              img.classList.remove('lazy');
              imageObserver.unobserve(img);
            }
          });
        });

        document.querySelectorAll('img[data-src]').forEach(img => {
          imageObserver.observe(img);
        });
      }
    </script>
