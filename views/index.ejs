<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RockfallAI — Next-Gen Slope Safety Platform</title>
    <meta name="description" content="Revolutionary AI-powered rockfall monitoring system with real-time alerts, predictive analytics, and comprehensive risk management for modern infrastructure." />

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              display: ["Inter", "ui-sans-serif", "system-ui"],
              mono: ["JetBrains Mono", "ui-monospace", "SFMono-Regular"]
            },
            colors: {
              brand: {
                50: '#fef2f2', 100: '#fee2e2', 200: '#fecaca', 300: '#fca5a5',
                400: '#f87171', 500: '#ef4444', 600: '#dc2626', 700: '#b91c1c',
                800: '#991b1b', 900: '#7f1d1d', 950: '#450a0a'
              },
              accent: {
                50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
                400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
                800: '#075985', 900: '#0c4a6e', 950: '#082f49'
              }
            },
            animation: {
              'fade-in': 'fadeIn 0.6s ease-out',
              'slide-up': 'slideUp 0.5s ease-out',
              'slide-in-left': 'slideInLeft 0.6s ease-out',
              'slide-in-right': 'slideInRight 0.6s ease-out',
              'bounce-subtle': 'bounceSubtle 2s infinite',
              'pulse-glow': 'pulseGlow 2s ease-in-out infinite',
              'float': 'float 6s ease-in-out infinite',
              'gradient-shift': 'gradientShift 8s ease-in-out infinite'
            },
            keyframes: {
              fadeIn: {
                '0%': { opacity: '0', transform: 'translateY(20px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' }
              },
              slideUp: {
                '0%': { opacity: '0', transform: 'translateY(40px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' }
              },
              slideInLeft: {
                '0%': { opacity: '0', transform: 'translateX(-40px)' },
                '100%': { opacity: '1', transform: 'translateX(0)' }
              },
              slideInRight: {
                '0%': { opacity: '0', transform: 'translateX(40px)' },
                '100%': { opacity: '1', transform: 'translateX(0)' }
              },
              bounceSubtle: {
                '0%, 100%': { transform: 'translateY(0)' },
                '50%': { transform: 'translateY(-8px)' }
              },
              pulseGlow: {
                '0%, 100%': { boxShadow: '0 0 20px rgba(220, 38, 38, 0.3)' },
                '50%': { boxShadow: '0 0 40px rgba(220, 38, 38, 0.6)' }
              },
              float: {
                '0%, 100%': { transform: 'translateY(0px)' },
                '50%': { transform: 'translateY(-20px)' }
              },
              gradientShift: {
                '0%, 100%': { backgroundPosition: '0% 50%' },
                '50%': { backgroundPosition: '100% 50%' }
              }
            },
            backdropBlur: {
              xs: '2px'
            }
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
      html { scroll-behavior: smooth; }
      :focus-visible { outline: 2px solid rgb(220, 38, 38); outline-offset: 2px; }
      
      .glass-effect {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(71, 85, 105, 0.2);
      }
      
      .gradient-border {
        background: linear-gradient(135deg, rgba(220, 38, 38, 0.1), rgba(14, 165, 233, 0.1));
        border: 1px solid transparent;
        background-clip: padding-box;
      }
      
      .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
      }
      
      .floating-element {
        animation: float 6s ease-in-out infinite;
      }
      
      .floating-element:nth-child(2) {
        animation-delay: 2s;
      }
      
      .floating-element:nth-child(3) {
        animation-delay: 4s;
      }
      
      .hero-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 25%, #334155 50%, #1e293b 75%, #0f172a 100%);
        background-size: 400% 400%;
        animation: gradientShift 8s ease-in-out infinite;
      }
      
      .testimonial-card {
        transition: all 0.3s ease;
      }
      
      .testimonial-card:hover {
        transform: scale(1.02);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }
      
      .pricing-card {
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }
      
      .pricing-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
      }
      
      .pricing-card.featured {
        background: linear-gradient(135deg, rgba(220, 38, 38, 0.1), rgba(14, 165, 233, 0.1));
        border: 2px solid rgba(220, 38, 38, 0.3);
      }
      
      .pricing-card.featured::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #dc2626, #0ea5e9);
      }
      
      .accordion-body { 
        max-height: 0; 
        overflow: hidden; 
        transition: max-height 0.3s ease; 
      }
      
      .accordion.open .accordion-body { 
        max-height: 320px; 
      }
      
      .search-highlight {
        background: rgba(220, 38, 38, 0.2);
        padding: 2px 4px;
        border-radius: 4px;
      }
      
      .newsletter-input {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(71, 85, 105, 0.3);
        transition: all 0.3s ease;
      }
      
      .newsletter-input:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
        background: rgba(15, 23, 42, 0.8);
      }
      
      .stats-counter {
        font-variant-numeric: tabular-nums;
      }
      
      .feature-icon {
        transition: all 0.3s ease;
      }
      
      .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(5deg);
      }
      
      .demo-canvas {
        background: radial-gradient(ellipse at center, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.9) 100%);
        transition: all 0.3s ease;
      }
      
      .demo-layer {
        transition: all 0.3s ease;
        opacity: 0.7;
      }
      
      .demo-layer.active {
        opacity: 1;
        transform: scale(1.05);
      }
    </style>
  </head>
