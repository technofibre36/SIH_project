<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Live Location Tracker - RockfallAI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: { display: ["Inter", "ui-sans-serif", "system-ui"] },
            colors: { brand: { 600: '#dc2626', 700: '#b91c1c' } }
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="/location/style.css">
  </head>
  <body class="min-h-screen bg-slate-100 dark:bg-slate-950 font-display text-slate-800 dark:text-slate-100">
    <!-- Header -->
    <header class="sticky top-0 z-30 bg-white/70 dark:bg-slate-900/60 backdrop-blur border-b border-slate-200/70 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="flex items-center gap-3 hover:opacity-80 transition">
            <div class="h-9 w-9 flex items-center justify-center rounded-xl bg-brand-600 text-white font-bold">NR</div>
            <span class="text-lg font-bold">Rockfall</span>
          </a>
          <div class="hidden md:flex items-center gap-2 ml-6">
            <i class="fas fa-location-dot text-brand-600"></i>
            <span class="text-sm font-medium">Live Location Tracking</span>
          </div>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
            <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
            <span class="text-xs font-medium">Live</span>
          </div>
          <button id="themeToggle" class="inline-flex items-center gap-2 rounded-xl border border-slate-300/70 dark:border-slate-700 px-3 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/60" aria-label="Toggle dark mode">
            <span id="themeIcon">🌙</span>
            <span class="hidden md:inline">Theme</span>
          </button>
          <a href="/precaution" class="rounded-xl bg-orange-600 px-4 py-2 text-white font-medium hover:bg-orange-700 transition flex items-center gap-2">
            <i class="fas fa-shield-alt"></i>
            <span>Precaution</span>
          </a>
          <a href="/dashboard" class="rounded-xl bg-brand-600 px-4 py-2 text-white font-medium hover:bg-brand-700 transition">Back to Dashboard</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-6 px-4 grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Stats Panel -->
      <aside class="lg:col-span-3 space-y-4">
        <!-- Connection Status -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/40 p-4">
          <h3 class="font-semibold mb-3 flex items-center gap-2">
            <i class="fas fa-wifi text-brand-600"></i>
            Connection Status
          </h3>
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600 dark:text-slate-300">Server</span>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                <span class="text-sm font-medium text-green-600 dark:text-green-400">Connected</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600 dark:text-slate-300">GPS</span>
              <div class="flex items-center gap-2">
                <div id="gpsStatus" class="w-2 h-2 bg-yellow-500 rounded-full"></div>
                <span id="gpsText" class="text-sm font-medium text-yellow-600 dark:text-yellow-400">Requesting</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Active Users -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/40 p-4">
          <h3 class="font-semibold mb-3 flex items-center gap-2">
            <i class="fas fa-users text-brand-600"></i>
            Active Users
          </h3>
          <div class="text-center">
            <div id="userCount" class="text-3xl font-bold text-brand-600 mb-2">0</div>
            <p class="text-sm text-slate-600 dark:text-slate-300">Currently tracking</p>
          </div>
        </div>

        <!-- Map Controls -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/40 p-4">
          <h3 class="font-semibold mb-3 flex items-center gap-2">
            <i class="fas fa-map-marked-alt text-brand-600"></i>
            Map Controls
          </h3>
          <div class="space-y-3">
            <button id="centerMap" class="w-full bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg flex items-center justify-center gap-2 transition">
              <i class="fas fa-crosshairs"></i>
              Center on Me
            </button>
            <button id="toggleTracking" class="w-full border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 px-4 py-2 rounded-lg flex items-center justify-center gap-2 transition">
              <i class="fas fa-pause"></i>
              Pause Tracking
            </button>
          </div>
        </div>

        <!-- Recent Activity -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/40 p-4">
          <h3 class="font-semibold mb-3 flex items-center gap-2">
            <i class="fas fa-history text-brand-600"></i>
            Recent Activity
          </h3>
          <div id="activityLog" class="space-y-2 max-h-40 overflow-y-auto">
            <div class="text-sm text-slate-500 dark:text-slate-400 italic">No recent activity</div>
          </div>
        </div>
      </aside>

      <!-- Map Container -->
      <main class="lg:col-span-9">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/40 overflow-hidden">
          <!-- Map Header -->
          <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 bg-gradient-to-r from-brand-600 to-brand-700">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <i class="fas fa-map text-white text-xl"></i>
                <div>
                  <h2 class="text-xl font-bold text-white">Live Location Map</h2>
                  <p class="text-brand-100 text-sm">Real-time position tracking for field operations</p>
                </div>
              </div>
              <div class="flex items-center gap-4 text-white">
                <div class="text-right">
                  <div class="text-sm opacity-80">Last Update</div>
                  <div id="lastUpdate" class="text-sm font-medium">--:--</div>
                </div>
                <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
              </div>
            </div>
          </div>
          
          <!-- Map -->
          <div id="map" class="h-[600px] relative">
            <!-- Loading Overlay -->
            <div id="mapLoading" class="absolute inset-0 bg-slate-100 dark:bg-slate-900 flex items-center justify-center z-10">
              <div class="text-center">
                <div class="w-12 h-12 border-4 border-brand-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                <p class="text-slate-600 dark:text-slate-300">Loading map...</p>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Toast Notifications -->
    <div id="toastContainer" class="fixed top-20 right-4 z-50 space-y-2"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="/location/script.js"></script>
  </body>
</html>


