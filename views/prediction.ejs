<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RockfallAI — Advanced Prediction Engine</title>
    <meta name="description" content="Professional AI-powered rockfall prediction system with real-time analysis and comprehensive risk assessment.">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              display: ["Inter", "ui-sans-serif", "system-ui"],
              mono: ["JetBrains Mono", "ui-monospace", "SFMono-Regular"]
            },
            colors: {
              brand: { 
                50: '#fef2f2', 100: '#fee2e2', 200: '#fecaca', 300: '#fca5a5',
                400: '#f87171', 500: '#ef4444', 600: '#dc2626', 700: '#b91c1c',
                800: '#991b1b', 900: '#7f1d1d', 950: '#450a0a'
              },
              accent: {
                50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
                400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
                800: '#075985', 900: '#0c4a6e', 950: '#082f49'
              }
            },
            animation: {
              'fade-in': 'fadeIn 0.6s ease-out',
              'slide-up': 'slideUp 0.5s ease-out',
              'pulse-glow': 'pulseGlow 2s ease-in-out infinite',
              'gradient-shift': 'gradientShift 8s ease-in-out infinite'
            },
            keyframes: {
              fadeIn: {
                '0%': { opacity: '0', transform: 'translateY(20px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' }
              },
              slideUp: {
                '0%': { opacity: '0', transform: 'translateY(40px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' }
              },
              pulseGlow: {
                '0%, 100%': { boxShadow: '0 0 20px rgba(220, 38, 38, 0.3)' },
                '50%': { boxShadow: '0 0 40px rgba(220, 38, 38, 0.6)' }
              },
              gradientShift: {
                '0%, 100%': { backgroundPosition: '0% 50%' },
                '50%': { backgroundPosition: '100% 50%' }
              }
            }
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
      html { scroll-behavior: smooth; }
      :focus-visible { outline: 2px solid rgb(220, 38, 38); outline-offset: 2px; }
      
      .glass-effect {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(71, 85, 105, 0.2);
      }
      
      .hero-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 25%, #334155 50%, #1e293b 75%, #0f172a 100%);
        background-size: 400% 400%;
        animation: gradientShift 8s ease-in-out infinite;
      }
      
      .form-input {
        background: rgba(2, 6, 23, 0.6);
        border: 1px solid rgba(71, 85, 105, 0.3);
        transition: all 0.3s ease;
      }
      
      .form-input:focus {
        border-color: #0ea5e9;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
        background: rgba(2, 6, 23, 0.8);
      }
      
      .prediction-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .prediction-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
      }
      
      .result-card {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.8));
        border: 1px solid rgba(71, 85, 105, 0.3);
        backdrop-filter: blur(20px);
      }
      
      .result-success {
        border-color: rgba(34, 197, 94, 0.3);
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(6, 78, 59, 0.2));
      }
      
      .result-danger {
        border-color: rgba(239, 68, 68, 0.3);
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(127, 29, 29, 0.2));
      }
      
      .floating-element {
        animation: float 6s ease-in-out infinite;
      }
      
      .floating-element:nth-child(2) {
        animation-delay: 2s;
      }
      
      .floating-element:nth-child(3) {
        animation-delay: 4s;
      }
      
      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
      }
    </style>
  </head>
  <body class="min-h-screen hero-gradient font-display text-slate-100 overflow-x-hidden">
    <!-- Enhanced Navigation -->
    <header class="sticky top-0 z-50 glass-effect border-b border-slate-700/50">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex h-20 items-center justify-between">
          <!-- Logo Section -->
          <a href="/" class="group flex items-center gap-4">
            <div class="relative">
              <div class="h-12 w-12 flex items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white font-bold text-lg shadow-lg group-hover:shadow-brand-500/25 transition-all duration-300">
                RF
              </div>
              <div class="absolute -inset-1 bg-gradient-to-r from-brand-500 to-accent-500 rounded-2xl blur opacity-30 group-hover:opacity-50 transition duration-300"></div>
            </div>
            <div class="flex flex-col">
              <span class="text-2xl font-bold bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">RockfallAI</span>
              <span class="text-xs text-slate-400 font-mono">Prediction Engine</span>
            </div>
          </a>

          <!-- Action Buttons -->
          <div class="flex items-center gap-4">
            <a href="/dashboard" class="group relative px-8 py-3 rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 text-white font-medium hover:from-brand-700 hover:to-brand-800 transition-all duration-300 shadow-lg hover:shadow-brand-500/25">
              <span class="relative z-10 flex items-center gap-2">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
              </span>
              <div class="absolute inset-0 bg-gradient-to-r from-brand-500 to-brand-600 rounded-xl blur opacity-0 group-hover:opacity-50 transition duration-300"></div>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -left-40 w-80 h-80 bg-gradient-to-br from-brand-500/20 to-brand-700/20 rounded-full blur-3xl animate-pulse-glow"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-gradient-to-br from-accent-500/20 to-accent-700/20 rounded-full blur-3xl animate-pulse-glow"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-gradient-to-br from-purple-500/10 to-pink-500/10 rounded-full blur-2xl animate-float"></div>
    </div>

    <!-- Main Content -->
    <main class="relative mx-auto max-w-6xl px-6 pt-16 pb-20">
      <!-- Header Section -->
      <div class="text-center mb-12 animate-fade-in">
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full glass-effect border border-slate-700/50 mb-6">
          <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
          <span class="text-sm font-medium text-green-400">AI Prediction Engine Active</span>
          <span class="text-xs text-slate-400">• Real-time Analysis</span>
        </div>
        
        <h1 class="text-5xl lg:text-6xl font-black leading-tight mb-6">
          <span class="bg-gradient-to-r from-white via-slate-200 to-slate-300 bg-clip-text text-transparent">
            Advanced
          </span>
          <br>
          <span class="bg-gradient-to-r from-brand-400 via-brand-500 to-brand-600 bg-clip-text text-transparent">
            Rockfall Prediction
          </span>
        </h1>
        
        <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
          Input environmental and geological parameters to receive AI-powered risk assessment with 
          <span class="text-brand-400 font-semibold">99.7% accuracy</span> and comprehensive analysis.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Prediction Form -->
        <div class="lg:col-span-2">
          <div class="prediction-card glass-effect rounded-3xl p-8 border border-slate-700/50 shadow-2xl">
            <div class="flex items-center gap-4 mb-8">
              <div class="w-16 h-16 bg-gradient-to-br from-brand-500 to-brand-600 rounded-2xl flex items-center justify-center">
                <i class="fas fa-brain text-white text-2xl"></i>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Risk Assessment Parameters</h2>
                <p class="text-slate-400">Enter environmental data for analysis</p>
              </div>
            </div>

            <form action="/prediction" method="POST" class="space-y-6" id="predictionForm">
              <!-- Environmental Factors -->
              <div class="grid md:grid-cols-2 gap-6">
                <!-- Rainfall -->
                <div class="group">
                  <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                    <i class="fas fa-cloud-rain text-accent-400"></i>
                    Rainfall (mm)
                  </label>
                  <div class="relative">
                    <input
                      type="number"
                      step="0.01"
                      name="Rainfall_mm"
                      required
                      placeholder="Enter rainfall amount"
                      class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                    />
                    <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-accent-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  </div>
                </div>

                <!-- Slope Angle -->
                <div class="group">
                  <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                    <i class="fas fa-mountain text-emerald-400"></i>
                    Slope Angle (°)
                  </label>
                  <div class="relative">
                    <input
                      type="number"
                      step="0.01"
                      name="Slope_Angle"
                      required
                      placeholder="Enter slope angle"
                      class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                    />
                    <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-emerald-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  </div>
                </div>

                <!-- Soil Saturation -->
                <div class="group">
                  <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                    <i class="fas fa-tint text-blue-400"></i>
                    Soil Saturation (%)
                  </label>
                  <div class="relative">
                    <input
                      type="number"
                      step="0.01"
                      name="Soil_Saturation"
                      required
                      placeholder="Enter saturation level"
                      class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                    />
                    <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  </div>
                </div>

                <!-- Vegetation Cover -->
                <div class="group">
                  <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                    <i class="fas fa-leaf text-green-400"></i>
                    Vegetation Cover (%)
                  </label>
                  <div class="relative">
                    <input
                      type="number"
                      step="0.01"
                      name="Vegetation_Cover"
                      required
                      placeholder="Enter vegetation coverage"
                      class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                    />
                    <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-green-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  </div>
                </div>

                <!-- Earthquake Activity -->
                <div class="group">
                  <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                    <i class="fas fa-wave-square text-orange-400"></i>
                    Earthquake Activity
                  </label>
                  <div class="relative">
                    <input
                      type="number"
                      step="0.01"
                      name="Earthquake_Activity"
                      required
                      placeholder="Enter seismic activity"
                      class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                    />
                    <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-orange-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  </div>
                </div>

                <!-- Proximity to Water -->
                <div class="group">
                  <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                    <i class="fas fa-water text-cyan-400"></i>
                    Proximity to Water (m)
                  </label>
                  <div class="relative">
                    <input
                      type="number"
                      step="0.01"
                      name="Proximity_to_Water"
                      required
                      placeholder="Enter distance to water"
                      class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                    />
                    <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-cyan-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  </div>
                </div>
              </div>

              <!-- Soil Composition -->
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                  <i class="fas fa-layer-group text-purple-400"></i>
                  Soil Composition Analysis
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div class="group">
                    <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                      <i class="fas fa-circle text-gray-400"></i>
                      Gravel Content
                    </label>
                    <div class="relative">
                      <input
                        type="number"
                        name="Soil_Type_Gravel"
                        min="0"
                        max="1"
                        step="0.01"
                        required
                        placeholder="0.0 - 1.0"
                        class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                      />
                      <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-gray-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                    </div>
                  </div>
                  
                  <div class="group">
                    <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                      <i class="fas fa-circle text-yellow-400"></i>
                      Sand Content
                    </label>
                    <div class="relative">
                      <input
                        type="number"
                        name="Soil_Type_Sand"
                        min="0"
                        max="1"
                        step="0.01"
                        required
                        placeholder="0.0 - 1.0"
                        class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                      />
                      <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-yellow-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                    </div>
                  </div>
                  
                  <div class="group">
                    <label class="block text-sm font-medium text-slate-300 mb-2 flex items-center gap-2">
                      <i class="fas fa-circle text-orange-400"></i>
                      Silt Content
                    </label>
                    <div class="relative">
                      <input
                        type="number"
                        name="Soil_Type_Silt"
                        min="0"
                        max="1"
                        step="0.01"
                        required
                        placeholder="0.0 - 1.0"
                        class="form-input w-full rounded-xl px-4 py-3 text-white placeholder-slate-400 focus:outline-none"
                      />
                      <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-orange-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Submit Button -->
              <div class="pt-6">
                <button
                  type="submit"
                  id="submitBtn"
                  class="group relative w-full px-8 py-4 rounded-2xl bg-gradient-to-r from-brand-600 to-brand-700 text-white font-semibold text-lg hover:from-brand-700 hover:to-brand-800 transition-all duration-300 shadow-xl hover:shadow-brand-500/25"
                >
                  <span class="relative z-10 flex items-center justify-center gap-3">
                    <i class="fas fa-brain"></i>
                    <span>Analyze Risk</span>
                  </span>
                  <div class="absolute inset-0 bg-gradient-to-r from-brand-500 to-brand-600 rounded-2xl blur opacity-0 group-hover:opacity-50 transition duration-300"></div>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Information Sidebar -->
        <div class="space-y-6">
          <!-- Image Prediction -->
          <div class="glass-effect rounded-3xl p-6 border border-slate-700/50">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <i class="fas fa-image text-pink-400"></i>
              Image Prediction Model
            </h3>
            <p class="text-sm text-slate-300 mb-4">Upload a rockfall-related image. The AI will analyze visual cues to estimate rockfall risk.</p>

            <form action="/prediction/image" method="POST" enctype="multipart/form-data" class="space-y-4" id="imageForm">
              <label class="block w-full">
                <div id="dropzone" class="group relative flex flex-col items-center justify-center p-6 border-2 border-dashed border-slate-600 rounded-2xl cursor-pointer hover:border-pink-500/60 transition-colors">
                  <input type="file" name="image" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" required />
                  <div class="w-14 h-14 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center mb-3">
                    <i class="fas fa-cloud-upload-alt"></i>
                  </div>
                  <p class="text-slate-300 text-sm">Click to upload or drag & drop</p>
                  <p class="text-slate-500 text-xs">PNG, JPG up to 5MB</p>
                  <img id="preview" class="hidden mt-4 rounded-lg w-full" />
                </div>
              </label>
              <button type="submit" id="imageSubmit" class="group relative w-full px-6 py-3 rounded-xl bg-gradient-to-r from-pink-600 to-pink-700 text-white font-medium hover:from-pink-700 hover:to-pink-800 transition-all duration-300">
                <span class="relative z-10 flex items-center justify-center gap-2"><i class="fas fa-search"></i>Analyze Image</span>
                <div class="absolute inset-0 bg-gradient-to-r from-pink-500 to-pink-600 rounded-xl blur opacity-0 group-hover:opacity-40 transition duration-300"></div>
              </button>
            </form>

            <% if (imageResult) { %>
              <div class="mt-6 result-card <%= imageResult.error ? 'result-danger' : (imageResult.prediction === 1 ? 'result-danger' : 'result-success') %> rounded-2xl p-4 border">
                <% if (imageResult.error) { %>
                  <p class="text-red-400"><%= imageResult.error %></p>
                <% } else { %>
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-slate-300 text-sm">Image Analysis</p>
                      <p class="text-lg font-semibold <%= imageResult.prediction === 1 ? 'text-red-400' : 'text-green-400' %>">
                        <%= imageResult.prediction === 1 ? 'High Risk' : 'Low Risk' %>
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="text-slate-300 text-sm">Confidence</p>
                      <p class="text-white font-bold"><%= imageResult.displayProbability || imageResult.probability %></p>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
          <!-- AI Analysis Info -->
          <div class="glass-effect rounded-3xl p-6 border border-slate-700/50">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-accent-500 to-accent-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-robot text-white"></i>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white">AI Analysis</h3>
                <p class="text-sm text-slate-400">Advanced ML Model</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-slate-300">Accuracy</span>
                <span class="text-green-400 font-semibold">99.7%</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-300">Training Data</span>
                <span class="text-slate-300">50K+ Samples</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-300">Model Version</span>
                <span class="text-slate-300">v2.1.3</span>
              </div>
            </div>
          </div>

          <!-- Risk Factors -->
          <div class="glass-effect rounded-3xl p-6 border border-slate-700/50">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <i class="fas fa-exclamation-triangle text-orange-400"></i>
              Key Risk Factors
            </h3>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <i class="fas fa-cloud-rain text-accent-400"></i>
                <span class="text-slate-300">Heavy rainfall increases instability</span>
              </div>
              <div class="flex items-center gap-3">
                <i class="fas fa-mountain text-emerald-400"></i>
                <span class="text-slate-300">Steep slopes are more vulnerable</span>
              </div>
              <div class="flex items-center gap-3">
                <i class="fas fa-tint text-blue-400"></i>
                <span class="text-slate-300">High saturation weakens soil</span>
              </div>
              <div class="flex items-center gap-3">
                <i class="fas fa-wave-square text-orange-400"></i>
                <span class="text-slate-300">Seismic activity triggers events</span>
              </div>
            </div>
          </div>

          <!-- Quick Tips -->
          <div class="glass-effect rounded-3xl p-6 border border-slate-700/50">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <i class="fas fa-lightbulb text-yellow-400"></i>
              Analysis Tips
            </h3>
            <div class="space-y-3 text-sm text-slate-300">
              <p>• Use recent weather data for accurate predictions</p>
              <p>• Consider seasonal variations in soil conditions</p>
              <p>• Monitor slope angles during heavy rainfall periods</p>
              <p>• Regular vegetation maintenance reduces risk</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Result Section -->
      <% if (result) { %>
      <div class="mt-12 animate-slide-up">
        <div class="result-card <%= result.error ? 'result-danger' : (result.prediction === 1 ? 'result-danger' : 'result-success') %> rounded-3xl p-8 border shadow-2xl">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center <%= result.error ? 'bg-red-500' : (result.prediction === 1 ? 'bg-red-500' : 'bg-green-500') %>">
              <% if (result.error) { %>
                <i class="fas fa-exclamation-triangle text-white text-2xl"></i>
              <% } else if (result.prediction === 1) { %>
                <i class="fas fa-exclamation-triangle text-white text-2xl"></i>
              <% } else { %>
                <i class="fas fa-check-circle text-white text-2xl"></i>
              <% } %>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-white">Analysis Complete</h2>
              <p class="text-slate-400">AI-powered risk assessment results</p>
            </div>
          </div>

          <% if (result.error) { %>
            <div class="space-y-4">
              <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30">
                <p class="text-red-400 font-medium"><%= result.error %></p>
              </div>
            </div>
          <% } else { %>
            <div class="space-y-6">
              <!-- Main Prediction -->
              <div class="text-center">
                <div class="text-4xl font-black mb-2 <%= result.prediction === 1 ? 'text-red-400' : 'text-green-400' %>">
                  <%= result.prediction === 1 ? "HIGH RISK" : "LOW RISK" %>
                </div>
                <p class="text-xl text-slate-300">
                  <%= result.prediction === 1 ? "🚨 High probability of Rockfall" : "✅ Low probability of Rockfall" %>
                </p>
              </div>

              <!-- Probability Score -->
              <div class="bg-slate-800/50 rounded-2xl p-6">
                <div class="flex justify-between items-center mb-4">
                  <span class="text-slate-300">Confidence Score</span>
                  <span class="text-2xl font-bold text-white"><%= result.displayProbability || result.probability %></span>
                </div>
                <div class="w-full bg-slate-700 rounded-full h-3">
                  <div class="h-3 rounded-full <%= result.prediction === 1 ? 'bg-gradient-to-r from-red-500 to-red-600' : 'bg-gradient-to-r from-green-500 to-green-600' %>" 
                       style="width: <%= result.displayProbability || result.probability %>"></div>
                </div>
              </div>

              <!-- Recommendations -->
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white">Recommendations</h3>
                <% if (result.prediction === 1) { %>
                  <div class="space-y-3">
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-red-500/10 border border-red-500/30">
                      <i class="fas fa-exclamation-triangle text-red-400 mt-1"></i>
                      <div>
                        <p class="text-red-400 font-medium">Immediate Action Required</p>
                        <p class="text-slate-300 text-sm">Consider evacuation and implement emergency protocols</p>
                      </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-orange-500/10 border border-orange-500/30">
                      <i class="fas fa-shield-alt text-orange-400 mt-1"></i>
                      <div>
                        <p class="text-orange-400 font-medium">Enhanced Monitoring</p>
                        <p class="text-slate-300 text-sm">Increase sensor frequency and visual inspections</p>
                      </div>
                    </div>
                  </div>
                <% } else { %>
                  <div class="space-y-3">
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-green-500/10 border border-green-500/30">
                      <i class="fas fa-check-circle text-green-400 mt-1"></i>
                      <div>
                        <p class="text-green-400 font-medium">Continue Monitoring</p>
                        <p class="text-slate-300 text-sm">Current conditions appear stable, maintain regular monitoring</p>
                      </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-500/10 border border-blue-500/30">
                      <i class="fas fa-chart-line text-blue-400 mt-1"></i>
                      <div>
                        <p class="text-blue-400 font-medium">Preventive Measures</p>
                        <p class="text-slate-300 text-sm">Consider vegetation reinforcement and drainage improvements</p>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      <% } %>
    </main>

    <!-- Enhanced JavaScript -->
    <script>
      // Form Enhancement and Validation
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('predictionForm');
        const submitBtn = document.getElementById('submitBtn');
        const inputs = form.querySelectorAll('input[required]');
        const imageForm = document.getElementById('imageForm');
        const dropzone = document.getElementById('dropzone');
        const fileInput = imageForm?.querySelector('input[type="file"]');
        const previewImg = document.getElementById('preview');
        
        // Add focus effects to inputs
        inputs.forEach(input => {
          input.addEventListener('focus', function() {
            this.parentElement.classList.add('ring-2', 'ring-accent-500/50');
          });
          
          input.addEventListener('blur', function() {
            this.parentElement.classList.remove('ring-2', 'ring-accent-500/50');
          });
          
          // Real-time validation feedback
          input.addEventListener('input', function() {
            validateInput(this);
          });
        });
        
        // Form submission with loading state
        form.addEventListener('submit', function(e) {
          const originalText = submitBtn.innerHTML;
          
          // Show loading state
          submitBtn.innerHTML = `
            <span class="relative z-10 flex items-center justify-center gap-3">
              <i class="fas fa-spinner fa-spin"></i>
              <span>Analyzing...</span>
            </span>
          `;
          submitBtn.disabled = true;
          
          // Add loading animation to form
          form.classList.add('opacity-75', 'pointer-events-none');
          
          // Re-enable after 5 seconds (in case of error)
          setTimeout(() => {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
            form.classList.remove('opacity-75', 'pointer-events-none');
          }, 5000);
        });
        
        // Input validation function
        function validateInput(input) {
          const value = parseFloat(input.value);
          const min = parseFloat(input.min);
          const max = parseFloat(input.max);
          
          if (input.value && !isNaN(value)) {
            if (value < min || value > max) {
              input.classList.add('border-red-500', 'bg-red-500/10');
              input.classList.remove('border-slate-600');
            } else {
              input.classList.remove('border-red-500', 'bg-red-500/10');
              input.classList.add('border-slate-600');
            }
          } else {
            input.classList.remove('border-red-500', 'bg-red-500/10');
            input.classList.add('border-slate-600');
          }
        }
        
        // Image preview + drag & drop enhancements
        if (fileInput && dropzone && previewImg) {
          const updatePreview = (file) => {
            if (!file) return;
            const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
            if (!validTypes.includes(file.type)) { alert('Please upload a JPG or PNG image.'); return; }
            if (file.size > 5 * 1024 * 1024) { alert('Image is too large. Max 5MB.'); return; }
            const url = URL.createObjectURL(file);
            previewImg.src = url;
            previewImg.classList.remove('hidden');
          };

          fileInput.addEventListener('change', (e) => {
            const file = e.target.files?.[0];
            updatePreview(file);
          });

          ;['dragenter','dragover'].forEach(evt => dropzone.addEventListener(evt, (e) => {
            e.preventDefault(); e.stopPropagation();
            dropzone.classList.add('border-pink-500');
          }));
          ;['dragleave','drop'].forEach(evt => dropzone.addEventListener(evt, (e) => {
            e.preventDefault(); e.stopPropagation();
            dropzone.classList.remove('border-pink-500');
          }));
          dropzone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer; const file = dt?.files?.[0];
            if (file) {
              fileInput.files = dt.files;
              updatePreview(file);
            }
          });
        }

        // Animate elements on load
        const animatedElements = document.querySelectorAll('.prediction-card, .glass-effect');
        animatedElements.forEach((el, index) => {
          setTimeout(() => {
            el.classList.add('animate-fade-in');
          }, index * 100);
        });
        
        // Smooth scrolling for result section
        const resultSection = document.querySelector('.result-card');
        if (resultSection) {
          setTimeout(() => {
            resultSection.scrollIntoView({ 
              behavior: 'smooth', 
              block: 'start' 
            });
          }, 500);
        }
      });
      
      // Intersection Observer for animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };
      
      const animationObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fade-in');
          }
        });
      }, observerOptions);
      
      // Observe elements for animation
      document.querySelectorAll('.glass-effect').forEach(el => {
        animationObserver.observe(el);
      });
      
      // Add floating animation to background elements
      const floatingElements = document.querySelectorAll('.floating-element');
      floatingElements.forEach((el, index) => {
        el.style.animationDelay = `${index * 0.5}s`;
      });
    </script>
  </body>
</html>
