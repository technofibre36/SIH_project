<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - RockfallAI</title>
    <meta name="description" content="Create your RockfallAI account to access advanced rockfall prediction features and real-time monitoring.">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/stylesheet/style.css">

    <!-- Dark Tech Theme Overrides (scoped) -->
    <style>
        :root {
            --bg-950: #0b1220;
            --bg-900: #0f172a;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --slate-300: #cbd5e1;
            --brand-500: #ef4444;
            --brand-600: #dc2626;
            --accent-500: #0ea5e9;
            --accent-600: #0284c7;
        }

        body.auth-page {
            min-height: 100vh;
            color: #e5e7eb;
            background: radial-gradient(90% 80% at 10% 10%, rgba(239,68,68,0.08), transparent 60%),
                        radial-gradient(80% 60% at 90% 40%, rgba(14,165,233,0.08), transparent 60%),
                        linear-gradient(135deg, var(--bg-950), var(--bg-900));
            overflow-x: hidden;
            font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        }

        /* Navbar */
        .navbar { position: sticky; top: 0; z-index: 50; background: rgba(15,23,42,.6); backdrop-filter: saturate(140%) blur(16px); border-bottom: 1px solid rgba(100,116,139,.2); }
        .nav-container { max-width: 1120px; margin: 0 auto; padding: 14px 20px; display:flex; justify-content: space-between; align-items:center; }
        .nav-logo { display:inline-flex; align-items:center; gap:10px; color:#fff; text-decoration:none; font-weight:800; }
        .nav-logo i { width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center; border-radius:12px; background: linear-gradient(135deg, var(--brand-500), var(--brand-600)); box-shadow: 0 10px 25px rgba(239,68,68,.25); }
        .nav-menu { display:flex; align-items:center; gap:12px; }
        .nav-link { color: var(--slate-300); text-decoration:none; padding:8px 12px; border-radius:10px; transition:.2s; }
        .nav-link:hover { color:#fff; background: rgba(148,163,184,.08); }
        .btn-secondary { background: rgba(14,165,233,.1); color:#e0f2fe; border:1px solid rgba(14,165,233,.35); padding:10px 14px; border-radius:12px; transition:.25s; text-decoration:none; display:inline-flex; align-items:center; gap:8px; }
        .btn-secondary:hover { background: rgba(14,165,233,.16); box-shadow: 0 10px 24px rgba(14,165,233,.18) inset, 0 10px 24px rgba(14,165,233,.18); }

        /* Background blobs */
        .auth-background { position: fixed; inset: 0; pointer-events: none; }
        .floating-shapes .shape { position: absolute; filter: blur(40px); opacity: .35; border-radius: 999px; animation: float 10s ease-in-out infinite; }
        .shape-1 { top: 12%; left: 6%; width: 220px; height: 220px; background: radial-gradient(circle, rgba(239,68,68,.35), rgba(239,68,68,.05)); }
        .shape-2 { bottom: 12%; right: 10%; width: 280px; height: 280px; background: radial-gradient(circle, rgba(14,165,233,.35), rgba(14,165,233,.05)); animation-delay: 2s; }
        .shape-3 { top: 40%; right: 24%; width: 160px; height: 160px; background: radial-gradient(circle, rgba(99,102,241,.28), rgba(99,102,241,.05)); animation-delay: 1s; }
        .shape-4 { bottom: 28%; left: 18%; width: 140px; height: 140px; background: radial-gradient(circle, rgba(34,197,94,.28), rgba(34,197,94,.05)); animation-delay: 3s; }
        .shape-5 { top: 18%; right: 8%; width: 120px; height: 120px; background: radial-gradient(circle, rgba(251,191,36,.28), rgba(251,191,36,.05)); animation-delay: 4s; }
        @keyframes float { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-18px);} }

        /* Layout */
        .auth-section { padding: 48px 20px; }
        .auth-container { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; }
        @media (max-width: 980px) { .auth-container { grid-template-columns: 1fr; gap: 24px; } .auth-illustration{ order: -1; } }

        /* Card */
        .auth-card { background: linear-gradient(180deg, rgba(15,23,42,.75), rgba(15,23,42,.6)); border: 1px solid rgba(100,116,139,.35); box-shadow: 0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.03); border-radius: 28px; padding: 36px 28px; position: relative; overflow: hidden; }
        .auth-card::after { content:""; position:absolute; inset:auto 0 0 0; height:3px; background: linear-gradient(90deg, var(--brand-500), var(--accent-500)); opacity:.6; }
        .auth-header { text-align:center; margin-bottom: 18px; }
        .auth-logo i { width: 70px; height: 70px; border-radius: 22px; display:inline-flex; align-items:center; justify-content:center; font-size: 28px; color:#fff; background: linear-gradient(135deg, var(--brand-500), var(--accent-500)); box-shadow: 0 18px 40px rgba(239,68,68,.28), 0 10px 26px rgba(14,165,233,.2); }
        .auth-header h1 { margin: 14px 0 4px; font-size: 28px; font-weight: 800; }
        .auth-header p { color: var(--slate-400); font-size: 14px; }

        /* Form */
        .auth-form .form-group { margin-top: 16px; }
        .auth-form label { display:block; margin-bottom: 8px; color: var(--slate-300); font-size: 13px; }
        .input-group { display:flex; align-items:center; gap:10px; background: rgba(2,6,23,.6); border:1px solid rgba(100,116,139,.35); border-radius: 14px; padding: 12px 14px; transition: .25s; }
        .input-group i { color: var(--slate-400); }
        .input-group input { flex:1; background: transparent; border: none; outline: none; color: #fff; font-size: 15px; }
        .input-group:focus-within { border-color: rgba(14,165,233,.6); box-shadow: 0 0 0 4px rgba(14,165,233,.12); }
        .password-toggle { background: transparent; border: none; color: var(--slate-400); cursor: pointer; }
        .password-toggle:hover { color: #fff; }
        .input-hint { margin-top: 6px; color: var(--slate-400); font-size: 12px; }

        /* Strength meter */
        .password-strength { margin-top: 10px; }
        .strength-bar { width: 100%; height: 8px; background: rgba(100,116,139,.25); border-radius: 999px; overflow: hidden; border: 1px solid rgba(100,116,139,.3); }
        .strength-fill { height: 100%; width: 0; background: var(--brand-500); transition: width .35s ease, background-color .25s ease; }
        .strength-text { margin-top: 6px; font-size: 12px; color: var(--slate-400); }

        /* Match indicator */
        .password-match { margin-top: 8px; font-size: 12px; color: var(--slate-400); display:flex; align-items:center; gap:8px; }
        .password-match.success { color: #22c55e; }
        .password-match.error { color: #ef4444; }

        .form-options { margin: 16px 2px 8px; display:grid; gap: 10px; }
        .checkbox-container { display:flex; align-items:center; gap: 10px; color: var(--slate-300); }
        .checkbox-container input { width: 16px; height: 16px; accent-color: var(--brand-500); }
        .forgot-link { color: var(--slate-300); text-decoration: none; }
        .forgot-link:hover { color: #fff; }

        .btn-primary { background: linear-gradient(135deg, var(--brand-600), var(--brand-500)); border: 1px solid rgba(239,68,68,.5); color:#fff; }
        .btn-primary.btn-full { width: 100%; padding: 14px 18px; border-radius: 14px; display:inline-flex; justify-content:center; align-items:center; gap: 10px; font-weight: 700; box-shadow: 0 14px 40px rgba(239,68,68,.18), inset 0 1px 0 rgba(255,255,255,.06); transition: .25s; }
        .btn-primary.btn-full:hover { transform: translateY(-1px); box-shadow: 0 18px 50px rgba(239,68,68,.28); }

        .auth-footer { margin-top: 14px; text-align:center; color: var(--slate-400); }
        .auth-footer a { color: #e5e7eb; text-decoration: none; }
        .auth-footer a:hover { color: #fff; text-decoration: underline; }

        /* Illustration */
        .auth-illustration { position: relative; border-radius: 28px; overflow: hidden; background: radial-gradient(120% 120% at 10% 10%, rgba(239,68,68,.08), transparent 60%), radial-gradient(120% 120% at 90% 90%, rgba(14,165,233,.08), transparent 60%), linear-gradient(180deg, rgba(15,23,42,.6), rgba(15,23,42,.4)); border: 1px solid rgba(100,116,139,.3); box-shadow: inset 0 1px 0 rgba(255,255,255,.04), 0 24px 60px rgba(0,0,0,.35); padding: 28px; }
        .illustration-content { position: relative; height: 320px; display:grid; place-items:center; }
        .main-illustration i { width: 84px; height: 84px; border-radius: 22px; display:inline-flex; align-items:center; justify-content:center; color:#fff; font-size: 36px; background: linear-gradient(135deg, var(--accent-500), var(--accent-600)); box-shadow: 0 18px 40px rgba(14,165,233,.25); }
        .floating-element { position: absolute; display:flex; align-items:center; gap:10px; padding: 10px 14px; border-radius: 14px; background: rgba(2,6,23,.6); border: 1px solid rgba(100,116,139,.35); color:#e5e7eb; box-shadow: 0 8px 22px rgba(0,0,0,.25); animation: float 8s ease-in-out infinite; }
        .floating-element i { color: #fde68a; }
        .element-1 { top: 16px; left: 16px; animation-delay: .5s; }
        .element-2 { bottom: 16px; right: 22px; animation-delay: 1.5s; }
        .illustration-text h2 { margin-top: 10px; font-size: 22px; font-weight: 800; }
        .illustration-text p { color: var(--slate-300); margin: 8px 0 14px; }
        .benefits-list { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
        .benefit { display:flex; align-items:center; gap: 10px; color: var(--slate-300); }
        .benefit i { color: #22c55e; }
    </style>
</head>
<body class="auth-page">
    <!-- Background Animation -->
    <div class="auth-background">
        <div class="floating-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
            <div class="shape shape-4"></div>
            <div class="shape shape-5"></div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-logo">
                <i class="fas fa-mountain"></i>
                <span>RockfallAI</span>
            </a>
            
            <div class="nav-menu">
                <a href="/" class="nav-link">Home</a>
                <a href="/login" class="nav-btn btn-secondary">Sign In</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <section class="auth-section">
        <div class="auth-container">
            <!-- Sign Up Form -->
            <div class="auth-card">
                <div class="auth-header">
                    <div class="auth-logo">
                        <i class="fas fa-mountain"></i>
                    </div>
                    <h1>Join RockfallAI</h1>
                    <p>Create your account and start predicting rockfall risks</p>
                </div>

                <form action="/register" method="post" class="auth-form">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-group">
                            <i class="fas fa-user"></i>
                            <input 
                                type="text" 
                                id="username" 
                                name="username" 
                                placeholder="Choose a unique username"
                                required
                                minlength="3"
                                maxlength="20"
                            >
                        </div>
                        <div class="input-hint">3-20 characters, letters and numbers only</div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                placeholder="Create a strong password"
                                required
                                minlength="8"
                            >
                            <button type="button" class="password-toggle" onclick="togglePassword()">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="password-strength">
                            <div class="strength-bar">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <div class="strength-text" id="strengthText">Password strength</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input 
                                type="password" 
                                id="confirmPassword" 
                                name="confirmPassword" 
                                placeholder="Confirm your password"
                                required
                            >
                            <button type="button" class="password-toggle" onclick="toggleConfirmPassword()">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="password-match" id="passwordMatch"></div>
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address (Optional)</label>
                        <div class="input-group">
                            <i class="fas fa-envelope"></i>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                placeholder="your.email@example.com"
                            >
                        </div>
                        <div class="input-hint">We'll use this to send you important updates</div>
                    </div>

                    <div class="form-options">
                        <div class="checkbox-container">
                            <input type="checkbox" id="terms" name="terms" required>
                            <label for="terms" class="checkmark"></label>
                            <span>I agree to the <a href="#" class="forgot-link">Terms of Service</a> and <a href="#" class="forgot-link">Privacy Policy</a></span>
                        </div>
                        
                        <div class="checkbox-container">
                            <input type="checkbox" id="newsletter" name="newsletter">
                            <label for="newsletter" class="checkmark"></label>
                            <span>Subscribe to our newsletter for updates and tips</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-full">
                        <i class="fas fa-user-plus"></i>
                        Create Account
                    </button>
                </form>


                <div class="auth-footer">
                    <p>Already have an account? <a href="/login">Sign in</a></p>
                </div>
            </div>

            <!-- Illustration -->
            <div class="auth-illustration">
                <div class="illustration-content">
                    <div class="main-illustration">
                        <i class="fas fa-rocket"></i>
                    </div>
                    
                    <div class="floating-element element-1">
                        <i class="fas fa-shield-alt"></i>
                        <span>Secure</span>
                    </div>
                    
                    <div class="floating-element element-2">
                        <i class="fas fa-chart-line"></i>
                        <span>Analytics</span>
                    </div>
                </div>
                
                <div class="illustration-text">
                    <h2>Start Your Journey</h2>
                    <p>Join thousands of professionals who trust RockfallAI to protect their communities and infrastructure from rockfall risks.</p>
                    
                    <div class="benefits-list">
                        <div class="benefit">
                            <i class="fas fa-check-circle"></i>
                            <span>Free 30-day trial</span>
                        </div>
                        <div class="benefit">
                            <i class="fas fa-check-circle"></i>
                            <span>No credit card required</span>
                        </div>
                        <div class="benefit">
                            <i class="fas fa-check-circle"></i>
                            <span>24/7 customer support</span>
                        </div>
                        <div class="benefit">
                            <i class="fas fa-check-circle"></i>
                            <span>Advanced AI predictions</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- JavaScript -->
    <script>
        // Password toggle functionality
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.querySelector('.password-toggle i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        function toggleConfirmPassword() {
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const toggleIcon = document.querySelectorAll('.password-toggle')[1].querySelector('i');
            
            if (confirmPasswordInput.type === 'password') {
                confirmPasswordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                confirmPasswordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Password strength checker
        function checkPasswordStrength(password) {
            let strength = 0;
            const strengthFill = document.getElementById('strengthFill');
            const strengthText = document.getElementById('strengthText');
            
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;
            
            const strengthLevels = ['Very Weak', 'Weak', 'Fair', 'Good', 'Strong'];
            const strengthColors = ['#ef4444', '#f59e0b', '#f59e0b', '#10b981', '#10b981'];
            
            strengthFill.style.width = (strength * 20) + '%';
            strengthFill.style.backgroundColor = strengthColors[strength - 1] || '#ef4444';
            strengthText.textContent = strengthLevels[strength - 1] || 'Very Weak';
        }

        // Password match checker
        function checkPasswordMatch() {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const matchDiv = document.getElementById('passwordMatch');
            
            if (confirmPassword.length > 0) {
                if (password === confirmPassword) {
                    matchDiv.innerHTML = '<i class="fas fa-check-circle"></i> Passwords match';
                    matchDiv.className = 'password-match success';
                } else {
                    matchDiv.innerHTML = '<i class="fas fa-times-circle"></i> Passwords do not match';
                    matchDiv.className = 'password-match error';
                }
            } else {
                matchDiv.innerHTML = '';
                matchDiv.className = 'password-match';
            }
        }

        // Form validation and enhancement
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('.auth-form');
            const inputs = document.querySelectorAll('input[required]');
            const passwordInput = document.getElementById('password');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            
            // Add focus effects
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                
                input.addEventListener('blur', function() {
                    if (!this.value) {
                        this.parentElement.classList.remove('focused');
                    }
                });
            });

            // Password strength monitoring
            passwordInput.addEventListener('input', function() {
                checkPasswordStrength(this.value);
                checkPasswordMatch();
            });

            // Password match monitoring
            confirmPasswordInput.addEventListener('input', checkPasswordMatch);

            // Form submission with loading state
            form.addEventListener('submit', function(e) {
                const password = passwordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                
                if (password !== confirmPassword) {
                    e.preventDefault();
                    alert('Passwords do not match!');
                    return;
                }
                
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating Account...';
                submitBtn.disabled = true;
                
                // Re-enable after 5 seconds (in case of error)
                setTimeout(() => {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }, 5000);
            });

            // Animate elements on load
            const authCard = document.querySelector('.auth-card');
            const illustration = document.querySelector('.auth-illustration');
            
            setTimeout(() => {
                authCard.classList.add('animate-in');
            }, 100);
            
            setTimeout(() => {
                illustration.classList.add('animate-in');
            }, 300);
        });

        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
</body>
</html>
