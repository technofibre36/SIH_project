<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rockfall Prevention & Safety - RockfallAI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: { display: ["Inter", "ui-sans-serif", "system-ui"] },
            colors: { 
              brand: { 600: '#dc2626', 700: '#b91c1c' },
              danger: { 500: '#ef4444', 600: '#dc2626', 700: '#b91c1c' },
              warning: { 500: '#f59e0b', 600: '#d97706', 700: '#b45309' },
              success: { 500: '#10b981', 600: '#059669', 700: '#047857' }
            },
            animation: {
              'fade-in': 'fadeIn 0.6s ease-out',
              'slide-up': 'slideUp 0.8s ease-out',
              'pulse-glow': 'pulseGlow 2s ease-in-out infinite',
              'float': 'float 3s ease-in-out infinite',
              'gradient-shift': 'gradientShift 3s ease-in-out infinite'
            },
            keyframes: {
              fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
              slideUp: { '0%': { opacity: '0', transform: 'translateY(30px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
              pulseGlow: { '0%, 100%': { boxShadow: '0 0 20px rgba(220, 38, 38, 0.3)' }, '50%': { boxShadow: '0 0 30px rgba(220, 38, 38, 0.6)' } },
              float: { '0%, 100%': { transform: 'translateY(0px)' }, '50%': { transform: 'translateY(-10px)' } },
              gradientShift: { '0%, 100%': { backgroundPosition: '0% 50%' }, '50%': { backgroundPosition: '100% 50%' } }
            }
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
      .glass-effect {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .hero-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 25%, #334155 50%, #1e293b 75%, #0f172a 100%);
        background-size: 400% 400%;
        animation: gradientShift 8s ease infinite;
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }
      .tool-card {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.8) 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
      }
      .tool-card:hover {
        border-color: rgba(220, 38, 38, 0.5);
        box-shadow: 0 10px 30px rgba(220, 38, 38, 0.2);
      }
      .safety-level-high { @apply bg-gradient-to-r from-red-500/20 to-red-600/20 border-red-500/50; }
      .safety-level-medium { @apply bg-gradient-to-r from-yellow-500/20 to-orange-500/20 border-yellow-500/50; }
      .safety-level-low { @apply bg-gradient-to-r from-green-500/20 to-emerald-500/20 border-green-500/50; }
    </style>
  </head>
  <body class="bg-slate-900 text-white min-h-screen">
    <!-- Navigation -->
    <nav class="glass-effect sticky top-0 z-50 border-b border-slate-700/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-4">
            <a href="/dashboard" class="flex items-center space-x-3 group">
              <div class="w-10 h-10 bg-gradient-to-br from-red-500 to-red-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-shield-alt text-white text-lg"></i>
              </div>
              <div>
                <h1 class="text-xl font-bold text-white">RockfallAI</h1>
                <p class="text-xs text-slate-400">Safety & Prevention</p>
              </div>
            </a>
          </div>
          
          <div class="flex items-center space-x-6">
            <a href="/location" class="text-slate-300 hover:text-white transition-colors duration-200 flex items-center space-x-2">
              <i class="fas fa-map-marker-alt"></i>
              <span>Location</span>
            </a>
            <a href="/dashboard" class="text-slate-300 hover:text-white transition-colors duration-200 flex items-center space-x-2">
              <i class="fas fa-tachometer-alt"></i>
              <span>Dashboard</span>
            </a>
            <div class="w-px h-6 bg-slate-600"></div>
            <button onclick="toggleTheme()" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 transition-colors duration-200">
              <i class="fas fa-moon text-slate-300"></i>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-gradient py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center animate-fade-in">
          <div class="inline-flex items-center space-x-2 bg-red-500/20 text-red-300 px-4 py-2 rounded-full text-sm font-medium mb-6">
            <i class="fas fa-exclamation-triangle"></i>
            <span>Critical Safety Information</span>
          </div>
          <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 animate-slide-up">
            Rockfall <span class="bg-gradient-to-r from-red-400 to-red-600 bg-clip-text text-transparent">Prevention</span>
          </h1>
          <p class="text-xl text-slate-300 mb-8 max-w-3xl mx-auto animate-slide-up">
            Comprehensive safety guidelines, prevention strategies, and essential tools for rockfall risk management. 
            Protect lives and infrastructure with expert knowledge and proven techniques.
          </p>
          <div class="flex flex-wrap justify-center gap-4 animate-slide-up">
            <div class="flex items-center space-x-2 bg-slate-800/50 px-4 py-2 rounded-lg">
              <i class="fas fa-users text-blue-400"></i>
              <span class="text-sm">Expert Guidelines</span>
            </div>
            <div class="flex items-center space-x-2 bg-slate-800/50 px-4 py-2 rounded-lg">
              <i class="fas fa-tools text-green-400"></i>
              <span class="text-sm">Safety Tools</span>
            </div>
            <div class="flex items-center space-x-2 bg-slate-800/50 px-4 py-2 rounded-lg">
              <i class="fas fa-shield-alt text-red-400"></i>
              <span class="text-sm">Risk Mitigation</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Safety Overview -->
    <section class="py-16 bg-slate-800/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-3 gap-6">
          <div class="glass-effect rounded-2xl p-6 text-center card-hover">
            <div class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-exclamation-triangle text-white text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">High Risk Areas</h3>
            <p class="text-slate-400 text-sm">Steep slopes, loose rocks, recent rainfall, and seismic activity increase rockfall probability significantly.</p>
          </div>
          
          <div class="glass-effect rounded-2xl p-6 text-center card-hover">
            <div class="w-16 h-16 bg-gradient-to-br from-yellow-500 to-orange-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-eye text-white text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Visual Inspection</h3>
            <p class="text-slate-400 text-sm">Regular monitoring of rock faces, cracks, and slope conditions is essential for early detection.</p>
          </div>
          
          <div class="glass-effect rounded-2xl p-6 text-center card-hover">
            <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-shield-alt text-white text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Prevention Measures</h3>
            <p class="text-slate-400 text-sm">Proper engineering controls, vegetation management, and drainage systems can significantly reduce risks.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-3 gap-8">
        
        <!-- Left Column - Prevention Guidelines -->
        <div class="lg:col-span-2 space-y-8">
          
          <!-- Risk Assessment -->
          <div class="glass-effect rounded-2xl p-8 card-hover">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-red-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-search text-white text-xl"></i>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Risk Assessment Guidelines</h2>
                <p class="text-slate-400">How to identify and evaluate rockfall hazards</p>
              </div>
            </div>
            
            <div class="space-y-6">
              <div class="safety-level-high rounded-xl p-6">
                <h3 class="text-lg font-semibold text-red-300 mb-3 flex items-center">
                  <i class="fas fa-exclamation-triangle mr-2"></i>
                  High Risk Indicators
                </h3>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-red-400 mt-1 text-xs"></i>
                    <span>Slope angles greater than 45 degrees</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-red-400 mt-1 text-xs"></i>
                    <span>Visible cracks or fractures in rock faces</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-red-400 mt-1 text-xs"></i>
                    <span>Recent heavy rainfall or snowmelt</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-red-400 mt-1 text-xs"></i>
                    <span>Seismic activity or blasting nearby</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-red-400 mt-1 text-xs"></i>
                    <span>Loose rocks or debris at slope base</span>
                  </li>
                </ul>
              </div>
              
              <div class="safety-level-medium rounded-xl p-6">
                <h3 class="text-lg font-semibold text-yellow-300 mb-3 flex items-center">
                  <i class="fas fa-exclamation-circle mr-2"></i>
                  Medium Risk Indicators
                </h3>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-yellow-400 mt-1 text-xs"></i>
                    <span>Slope angles between 30-45 degrees</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-yellow-400 mt-1 text-xs"></i>
                    <span>Moderate vegetation cover</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-yellow-400 mt-1 text-xs"></i>
                    <span>Seasonal weather changes</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-yellow-400 mt-1 text-xs"></i>
                    <span>Human activity or construction nearby</span>
                  </li>
                </ul>
              </div>
              
              <div class="safety-level-low rounded-xl p-6">
                <h3 class="text-lg font-semibold text-green-300 mb-3 flex items-center">
                  <i class="fas fa-check-circle mr-2"></i>
                  Low Risk Indicators
                </h3>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-green-400 mt-1 text-xs"></i>
                    <span>Slope angles less than 30 degrees</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-green-400 mt-1 text-xs"></i>
                    <span>Dense vegetation cover</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-green-400 mt-1 text-xs"></i>
                    <span>Stable geological conditions</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-chevron-right text-green-400 mt-1 text-xs"></i>
                    <span>Proper drainage systems in place</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Prevention Measures -->
          <div class="glass-effect rounded-2xl p-8 card-hover">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-shield-alt text-white text-xl"></i>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Prevention Measures</h2>
                <p class="text-slate-400">Engineering and management strategies to reduce rockfall risk</p>
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-2 gap-6">
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white flex items-center">
                  <i class="fas fa-hammer mr-2 text-blue-400"></i>
                  Engineering Controls
                </h3>
                <ul class="space-y-3 text-slate-300">
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Rock Bolting</span>
                      <p class="text-sm text-slate-400">Install rock bolts to stabilize loose rock masses</p>
                    </div>
                  </li>
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Wire Mesh</span>
                      <p class="text-sm text-slate-400">Install wire mesh to catch falling rocks</p>
                    </div>
                  </li>
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Retaining Walls</span>
                      <p class="text-sm text-slate-400">Build retaining structures to support slopes</p>
                    </div>
                  </li>
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Drainage Systems</span>
                      <p class="text-sm text-slate-400">Install proper drainage to reduce water pressure</p>
                    </div>
                  </li>
                </ul>
              </div>
              
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white flex items-center">
                  <i class="fas fa-leaf mr-2 text-green-400"></i>
                  Vegetation Management
                </h3>
                <ul class="space-y-3 text-slate-300">
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Root Reinforcement</span>
                      <p class="text-sm text-slate-400">Plant deep-rooted vegetation to stabilize soil</p>
                    </div>
                  </li>
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Erosion Control</span>
                      <p class="text-sm text-slate-400">Use erosion control blankets and mats</p>
                    </div>
                  </li>
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Slope Grading</span>
                      <p class="text-sm text-slate-400">Modify slope angles to reduce instability</p>
                    </div>
                  </li>
                  <li class="flex items-start space-x-3">
                    <i class="fas fa-check text-green-400 mt-1"></i>
                    <div>
                      <span class="font-medium">Monitoring Systems</span>
                      <p class="text-sm text-slate-400">Install sensors and cameras for continuous monitoring</p>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Emergency Response -->
          <div class="glass-effect rounded-2xl p-8 card-hover">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-red-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-ambulance text-white text-xl"></i>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Emergency Response</h2>
                <p class="text-slate-400">Critical actions to take during and after rockfall events</p>
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-2 gap-6">
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white flex items-center">
                  <i class="fas fa-exclamation-triangle mr-2 text-red-400"></i>
                  Immediate Actions
                </h3>
                <ol class="space-y-3 text-slate-300">
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-red-500 text-white text-sm rounded-full flex items-center justify-center font-bold">1</span>
                    <span>Evacuate the area immediately if safe to do so</span>
                  </li>
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-red-500 text-white text-sm rounded-full flex items-center justify-center font-bold">2</span>
                    <span>Call emergency services (911 or local emergency number)</span>
                  </li>
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-red-500 text-white text-sm rounded-full flex items-center justify-center font-bold">3</span>
                    <span>Warn others in the vicinity about the danger</span>
                  </li>
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-red-500 text-white text-sm rounded-full flex items-center justify-center font-bold">4</span>
                    <span>Do not attempt to move large rocks or debris</span>
                  </li>
                </ol>
              </div>
              
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white flex items-center">
                  <i class="fas fa-clipboard-list mr-2 text-blue-400"></i>
                  Post-Event Actions
                </h3>
                <ol class="space-y-3 text-slate-300">
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-blue-500 text-white text-sm rounded-full flex items-center justify-center font-bold">1</span>
                    <span>Assess the extent of damage and injuries</span>
                  </li>
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-blue-500 text-white text-sm rounded-full flex items-center justify-center font-bold">2</span>
                    <span>Document the incident with photos and notes</span>
                  </li>
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-blue-500 text-white text-sm rounded-full flex items-center justify-center font-bold">3</span>
                    <span>Notify relevant authorities and stakeholders</span>
                  </li>
                  <li class="flex items-start space-x-3">
                    <span class="w-6 h-6 bg-blue-500 text-white text-sm rounded-full flex items-center justify-center font-bold">4</span>
                    <span>Conduct a thorough safety assessment before re-entry</span>
                  </li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Tools and Resources -->
        <div class="space-y-8">
          
          <!-- Safety Tools -->
          <div class="glass-effect rounded-2xl p-6">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-tools text-white text-lg"></i>
              </div>
              <h2 class="text-xl font-bold text-white">Safety Tools</h2>
            </div>
            
            <div class="space-y-4">
              <div class="tool-card rounded-xl p-4">
                <div class="flex items-center space-x-3 mb-2">
                  <i class="fas fa-ruler text-blue-400"></i>
                  <span class="font-medium text-white">Slope Inclinometer</span>
                </div>
                <p class="text-sm text-slate-400">Measure slope angles accurately for risk assessment</p>
              </div>
              
              <div class="tool-card rounded-xl p-4">
                <div class="flex items-center space-x-3 mb-2">
                  <i class="fas fa-thermometer-half text-orange-400"></i>
                  <span class="font-medium text-white">Moisture Meter</span>
                </div>
                <p class="text-sm text-slate-400">Monitor soil saturation levels and water content</p>
              </div>
              
              <div class="tool-card rounded-xl p-4">
                <div class="flex items-center space-x-3 mb-2">
                  <i class="fas fa-camera text-green-400"></i>
                  <span class="font-medium text-white">Crack Monitor</span>
                </div>
                <p class="text-sm text-slate-400">Track crack propagation and rock movement</p>
              </div>
              
              <div class="tool-card rounded-xl p-4">
                <div class="flex items-center space-x-3 mb-2">
                  <i class="fas fa-satellite-dish text-purple-400"></i>
                  <span class="font-medium text-white">GPS Survey Kit</span>
                </div>
                <p class="text-sm text-slate-400">Precise location mapping and monitoring</p>
              </div>
              
              <div class="tool-card rounded-xl p-4">
                <div class="flex items-center space-x-3 mb-2">
                  <i class="fas fa-shield-alt text-red-400"></i>
                  <span class="font-medium text-white">Safety Barriers</span>
                </div>
                <p class="text-sm text-slate-400">Temporary protection during high-risk periods</p>
              </div>
            </div>
          </div>

          <!-- Weather Monitoring -->
          <div class="glass-effect rounded-2xl p-6">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 to-cyan-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-cloud-rain text-white text-lg"></i>
              </div>
              <h2 class="text-xl font-bold text-white">Weather Monitoring</h2>
            </div>
            
            <div class="space-y-4">
              <div class="bg-slate-800/50 rounded-xl p-4">
                <h3 class="font-semibold text-white mb-2 flex items-center">
                  <i class="fas fa-rainbow mr-2 text-cyan-400"></i>
                  Critical Weather Factors
                </h3>
                <ul class="space-y-2 text-sm text-slate-300">
                  <li>• Rainfall intensity and duration</li>
                  <li>• Snowmelt rates and timing</li>
                  <li>• Freeze-thaw cycles</li>
                  <li>• Wind speed and direction</li>
                  <li>• Temperature fluctuations</li>
